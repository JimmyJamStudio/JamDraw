{
  "name": "JamDraw",
  "short_name": "JamDraw",
  "description": "A friendly vector drawing app: pen, pressure brush, shapes, layers, swatches and SVG export.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16121a",
  "theme_color": "#16121a",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".jamdraw"], "image/svg+xml": [".svg"] } }
  ]
}
